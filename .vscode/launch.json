{
  "version": "0.2.0",
  "configurations": [
    {
      "name": ".NET Core Launch (Web.Mvc)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/backend/src/MyCompany.MyProject.Web.Mvc/bin/Debug/net9.0/MyCompany.MyProject.Web.Mvc.dll",
      "args": [],
      "cwd": "${workspaceFolder}/backend/src/MyCompany.MyProject.Web.Mvc",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "DOTNET_ROLL_FORWARD": "Major"
      },
      "sourceFileMap": {
        "/Views": "${workspaceFolder}/backend/src/MyCompany.MyProject.Web.Mvc/Views"
      }
    }
  ]
}
