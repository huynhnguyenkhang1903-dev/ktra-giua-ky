@using MyCompany.MyProject.Exams.Dto
@model ExamDetailDto
@{
    ViewBag.Title = "Xem trước Đề thi: " + Model.Title;
}

<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-7">
                <h1 class="m-0 text-dark">
                    <i class="fas fa-eye text-info mr-2"></i>Xem trước Đề thi: <span class="text-primary">@Model.Title</span>
                </h1>
                <p class="text-muted mb-0">Rà soát nội dung câu hỏi, bài đọc, đáp án đúng và hình ảnh đính kèm trước khi cho học viên thi.</p>
            </div>
            <div class="col-sm-5 text-right">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning shadow-sm">
                    <i class="fas fa-edit mr-1"></i> Chỉnh sửa Đề thi
                </a>
                <a asp-action="Take" asp-route-id="@Model.Id" class="btn btn-primary shadow-sm ml-1">
                    <i class="fas fa-play mr-1"></i> Thi thử nghiệm
                </a>
                <a asp-action="Index" class="btn btn-secondary shadow-sm ml-1">
                    <i class="fas fa-arrow-left mr-1"></i> Danh sách
                </a>
            </div>
        </div>
    </div>
</section>

<section class="content">
    <div class="container-fluid">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                <i class="fas fa-check-circle mr-2"></i>@TempData["SuccessMessage"]
                <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
        }

        <!-- Thông tin tổng quan -->
        <div class="card card-outline card-primary shadow-sm mb-4">
            <div class="card-body">
                <div class="row text-center">
                    <div class="col-md-4 border-right">
                        <div class="text-muted small text-uppercase">Thời gian làm bài</div>
                        <h4 class="font-weight-bold text-dark"><i class="far fa-clock text-warning mr-1"></i>@Model.DurationMinutes phút</h4>
                    </div>
                    <div class="col-md-4 border-right">
                        <div class="text-muted small text-uppercase">Tổng số câu hỏi</div>
                        <h4 class="font-weight-bold text-dark"><i class="fas fa-question-circle text-info mr-1"></i>@Model.TotalQuestions câu</h4>
                    </div>
                    <div class="col-md-4">
                        <div class="text-muted small text-uppercase">Số nhóm bài đọc</div>
                        <h4 class="font-weight-bold text-dark"><i class="fas fa-layer-group text-success mr-1"></i>@Model.QuestionGroups.Count nhóm</h4>
                    </div>
                </div>
            </div>
        </div>

        <!-- Duyệt từng nhóm và câu hỏi -->
        @foreach (var group in Model.QuestionGroups.OrderBy(g => g.PartNumber).ThenBy(g => g.OrderIndex))
        {
            <div class="card card-outline @(group.PartNumber == 5 ? "card-secondary" : group.PartNumber == 6 ? "card-info" : "card-primary") shadow-sm mb-4">
                <div class="card-header bg-light">
                    <h5 class="card-title font-weight-bold mb-0">
                        <span class="badge @(group.PartNumber == 5 ? "badge-secondary" : group.PartNumber == 6 ? "badge-info" : "badge-primary") mr-2">Part @group.PartNumber</span>
                        @group.PassageTitle
                    </h5>
                    <div class="card-tools">
                        <span class="badge badge-light border">@group.Questions.Count câu hỏi</span>
                    </div>
                </div>
                <div class="card-body">
                    @if (!string.IsNullOrWhiteSpace(group.PassageContent) && group.PartNumber != 5)
                    {
                        <div class="p-3 mb-4 rounded bg-light border" style="white-space: pre-line; font-size: 1.05rem; line-height: 1.6; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;">
                            @group.PassageContent
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(group.PassageImage))
                    {
                        <div class="text-center my-3">
                            <img src="@group.PassageImage" class="img-fluid rounded border shadow-sm" alt="Passage Image" style="max-height: 500px;" />
                        </div>
                    }

                    <div class="row">
                        @foreach (var q in group.Questions.OrderBy(x => x.QuestionNumber))
                        {
                            <div class="col-md-@(group.PartNumber == 5 ? "6" : "12") mb-3">
                                <div class="p-3 border rounded h-100 bg-white shadow-xs">
                                    <div class="font-weight-bold text-dark mb-2">
                                        <span class="badge badge-dark mr-1">Câu @q.QuestionNumber</span>
                                        @q.QuestionText
                                    </div>
                                    <div class="pl-2 small">
                                        <div class="py-1 @(q.CorrectOption == "A" ? "font-weight-bold text-success bg-light rounded px-2" : "text-muted")">
                                            (A) @q.OptionA @(q.CorrectOption == "A" ? "✓ [ĐÁP ÁN ĐÚNG]" : "")
                                        </div>
                                        <div class="py-1 @(q.CorrectOption == "B" ? "font-weight-bold text-success bg-light rounded px-2" : "text-muted")">
                                            (B) @q.OptionB @(q.CorrectOption == "B" ? "✓ [ĐÁP ÁN ĐÚNG]" : "")
                                        </div>
                                        <div class="py-1 @(q.CorrectOption == "C" ? "font-weight-bold text-success bg-light rounded px-2" : "text-muted")">
                                            (C) @q.OptionC @(q.CorrectOption == "C" ? "✓ [ĐÁP ÁN ĐÚNG]" : "")
                                        </div>
                                        <div class="py-1 @(q.CorrectOption == "D" ? "font-weight-bold text-success bg-light rounded px-2" : "text-muted")">
                                            (D) @q.OptionD @(q.CorrectOption == "D" ? "✓ [ĐÁP ÁN ĐÚNG]" : "")
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</section>
