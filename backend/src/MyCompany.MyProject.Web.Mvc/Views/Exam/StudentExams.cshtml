@using MyCompany.MyProject.Exams.Dto
@model List<ExamListDto>
@{
    Layout = "~/Views/Shared/_MobileAppLayout.cshtml";
    ViewBag.Title = "Luyện đề TOEIC";
}

<style>
    .mobile-header {
        padding: 14px 20px 8px;
        background: #ffffff;
    }
    .search-bar {
        background: #f1f5f9;
        border-radius: 14px;
        padding: 10px 16px;
        display: flex;
        align-items: center;
        gap: 10px;
        color: #94a3b8;
        font-size: 0.85rem;
        margin: 12px 20px;
    }
    .promo-card {
        background: linear-gradient(135deg, #4338ca 0%, #6366f1 100%);
        border-radius: 20px;
        margin: 0 20px 18px;
        padding: 20px;
        color: white;
        position: relative;
        overflow: hidden;
    }
    .promo-card::after {
        content: '';
        position: absolute;
        right: -20px;
        bottom: -20px;
        width: 120px;
        height: 120px;
        background: rgba(255, 255, 255, 0.12);
        border-radius: 50%;
    }
    .category-pills {
        display: flex;
        gap: 10px;
        padding: 0 20px;
        overflow-x: auto;
        margin-bottom: 18px;
    }
    .category-pill {
        padding: 10px 14px;
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        font-size: 0.75rem;
        font-weight: 700;
        color: #475569;
        text-align: center;
        flex: 1;
        cursor: pointer;
        transition: all 0.2s;
    }
    .category-pill.active {
        background: #eef2ff;
        border-color: #6366f1;
        color: #4f46e5;
    }
    .category-pill i {
        display: block;
        font-size: 1.1rem;
        margin-bottom: 4px;
    }
    .exam-card-m {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 18px;
        padding: 16px;
        margin: 0 20px 14px;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.03);
        transition: transform 0.2s;
        cursor: pointer;
    }
    .exam-card-m:hover {
        transform: translateY(-2px);
        border-color: #cbd5e1;
    }
    .tag-badge {
        font-size: 0.65rem;
        font-weight: 800;
        padding: 3px 8px;
        border-radius: 6px;
        text-transform: uppercase;
    }
    .btn-mobile-primary {
        background: #4f46e5;
        color: white !important;
        font-weight: 700;
        font-size: 0.85rem;
        border-radius: 12px;
        padding: 10px 16px;
        border: none;
        display: block;
        text-align: center;
        width: 100%;
        box-shadow: 0 4px 12px rgba(79, 70, 229, 0.3);
    }
</style>

<!-- Screen 1 & 2: Trang chủ / Chọn đề (Figma Screen 1 & 2) -->
<div class="mobile-header d-flex justify-content-between align-items-center">
    <div>
        <div class="text-muted" style="font-size: 0.75rem;">Chào buổi sáng, Khang!</div>
        <h5 class="font-weight-bold text-dark mb-0">Luyện TOEIC mỗi ngày</h5>
    </div>
    <div class="position-relative">
        <button class="btn btn-light rounded-circle shadow-sm" style="width: 38px; height: 38px; padding: 0;">
            <i class="far fa-bell text-dark"></i>
        </button>
    </div>
</div>

<!-- Search Bar -->
<div class="search-bar">
    <i class="fas fa-search"></i>
    <span>Tìm đề thi, chủ đề TOEIC...</span>
</div>

<!-- Hero Banner Card -->
<div class="promo-card">
    <div class="badge badge-light px-2 py-1 text-primary font-weight-bold mb-2" style="font-size: 0.65rem;">
        MỖI NGÀY MỘT CHÚT
    </div>
    <h6 class="font-weight-bold mb-1">Luyện Reading ETS mỗi ngày.</h6>
    <p class="mb-3 text-white-50" style="font-size: 0.75rem;">Bạn đã hoàn thành 100 câu đọc hiểu tuần này.</p>
    <a href="#section-exams" class="btn btn-light btn-sm font-weight-bold text-primary rounded-pill px-3" style="font-size: 0.75rem;">
        Khám phá đề thi <i class="fas fa-arrow-right ml-1"></i>
    </a>
</div>

<!-- Chọn phần thi (Figma Category Pills) -->
<div class="d-flex justify-content-between align-items-center px-4 mb-2">
    <span class="font-weight-bold text-dark" style="font-size: 0.85rem;">Chọn phần thi</span>
    <span class="text-primary font-weight-bold" style="font-size: 0.75rem;">Tất cả</span>
</div>
<div class="category-pills">
    <div class="category-pill">
        <i class="fas fa-headphones text-primary"></i>
        Listening
        <div class="text-muted small" style="font-size: 0.65rem;">100 câu</div>
    </div>
    <div class="category-pill active">
        <i class="fas fa-book-open text-primary"></i>
        Reading
        <div class="text-muted small" style="font-size: 0.65rem;">100 câu</div>
    </div>
    <div class="category-pill">
        <i class="fas fa-layer-group text-primary"></i>
        Full Test
        <div class="text-muted small" style="font-size: 0.65rem;">200 câu</div>
    </div>
</div>

<!-- Đề thi đề xuất -->
<div id="section-exams">
    <div class="d-flex justify-content-between align-items-center px-4 mb-2">
        <span class="font-weight-bold text-dark" style="font-size: 0.85rem;">Đề thi phù hợp</span>
        <span class="text-muted" style="font-size: 0.75rem;">Mới nhất <i class="fas fa-chevron-down ml-1"></i></span>
    </div>

    @if (Model != null && Model.Any())
    {
        @foreach (var exam in Model)
        {
            <div class="exam-card-m" data-toggle="modal" data-target="#detailModal_@exam.Id">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="tag-badge bg-light text-primary font-weight-bold">TOEIC READING</span>
                    <span class="badge badge-pill badge-primary" style="font-size: 0.65rem;">Intermediate</span>
                </div>
                <h6 class="font-weight-bold text-dark mb-1">@exam.Title</h6>
                <div class="text-muted mb-3" style="font-size: 0.75rem;">
                    <i class="fas fa-file-alt mr-1"></i>Part 5, 6, 7 &nbsp;•&nbsp; 
                    <i class="far fa-clock mr-1"></i>@exam.DurationMinutes phút &nbsp;•&nbsp; 
                    <i class="fas fa-list-ol mr-1"></i>@exam.TotalQuestions câu
                </div>

                <div class="d-flex gap-2">
                    <button class="btn btn-outline-secondary btn-sm rounded-pill flex-fill mr-1 font-weight-bold" style="font-size: 0.75rem;">
                        Chi tiết đề
                    </button>
                    <a asp-action="Take" asp-route-id="@exam.Id" class="btn btn-mobile-primary flex-fill rounded-pill" onclick="event.stopPropagation();">
                        Vào thi ngay <i class="fas fa-arrow-right ml-1"></i>
                    </a>
                </div>
            </div>

            <!-- Modal Chi tiết đề thi (Màn hình 3 Figma dạng Mobile Popup) -->
            <div class="modal fade" id="detailModal_@exam.Id" tabindex="-1" role="dialog" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered mx-3" role="document">
                    <div class="modal-content border-0 shadow-lg" style="border-radius: 24px; overflow: hidden;">
                        <div class="modal-header border-0 pb-0">
                            <span class="tag-badge bg-primary text-white">TIẾNG ANH • TOEIC PRACTICE</span>
                            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                <span aria-hidden="true">&times;</span>
                            </button>
                        </div>
                        <div class="modal-body p-4">
                            <h5 class="font-weight-bold text-dark mb-1">@exam.Title</h5>
                            <p class="text-muted mb-3" style="font-size: 0.75rem;">100 câu đọc hiểu - Tổng thời gian 75 phút</p>

                            <!-- 3 Stat Thẻ Tròn (Figma Screen 3) -->
                            <div class="row text-center mb-3">
                                <div class="col-4">
                                    <div class="p-2 bg-light rounded-lg">
                                        <i class="far fa-clock text-primary mb-1"></i>
                                        <div class="font-weight-bold text-dark" style="font-size: 0.8rem;">@exam.DurationMinutes phút</div>
                                        <div class="text-muted" style="font-size: 0.65rem;">Tổng thời gian</div>
                                    </div>
                                </div>
                                <div class="col-4">
                                    <div class="p-2 bg-light rounded-lg">
                                        <i class="fas fa-tasks text-success mb-1"></i>
                                        <div class="font-weight-bold text-dark" style="font-size: 0.8rem;">@exam.TotalQuestions câu</div>
                                        <div class="text-muted" style="font-size: 0.65rem;">Tổng câu hỏi</div>
                                    </div>
                                </div>
                                <div class="col-4">
                                    <div class="p-2 bg-light rounded-lg">
                                        <i class="fas fa-signal text-warning mb-1"></i>
                                        <div class="font-weight-bold text-dark" style="font-size: 0.8rem;">Khá</div>
                                        <div class="text-muted" style="font-size: 0.65rem;">Độ khó</div>
                                    </div>
                                </div>
                            </div>

                            <div class="bg-light p-3 rounded-lg mb-3">
                                <div class="font-weight-bold text-dark mb-1" style="font-size: 0.8rem;">Part 5–7 &bull; Reading</div>
                                <div class="text-muted" style="font-size: 0.72rem;">100 câu đọc hiểu gồm từ vựng, ngữ pháp và bài đọc đoạn văn chuẩn ETS.</div>
                            </div>

                            <div class="text-muted mb-4" style="font-size: 0.72rem;">
                                <div class="font-weight-bold text-dark mb-1">Hướng dẫn làm bài:</div>
                                <div>1. Đọc bài và chọn 1 đáp án A, B, C hoặc D.</div>
                                <div>2. Bảng câu hỏi cho phép chuyển nhanh giữa các câu.</div>
                                <div>3. Bài thi tự động nộp khi hết 75 phút. Không tạm dừng.</div>
                            </div>

                            <a asp-action="Take" asp-route-id="@exam.Id" class="btn btn-mobile-primary py-3 rounded-pill font-weight-bold">
                                Bắt đầu làm bài <i class="fas fa-arrow-right ml-1"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="text-center py-4 px-3 text-muted">
            <i class="fas fa-folder-open fa-2x mb-2"></i>
            <div>Chưa có đề thi nào. Vui lòng vào trang Admin để import file Word.</div>
        </div>
    }
</div>

<div class="py-3"></div>

<!-- Bottom Nav (Figma Style) -->
<div class="bottom-nav">
    <a href="/Exam/StudentExams" class="nav-item-btn active">
        <i class="fas fa-home"></i>
        <span>Trang chủ</span>
    </a>
    <a href="/Exam/StudentExams" class="nav-item-btn">
        <i class="fas fa-book-open"></i>
        <span>Đề thi</span>
    </a>
    <a href="/Exam/Result/1" class="nav-item-btn">
        <i class="fas fa-chart-line"></i>
        <span>Kết quả</span>
    </a>
    <a href="/Exam" class="nav-item-btn">
        <i class="fas fa-user-cog"></i>
        <span>Admin</span>
    </a>
</div>
