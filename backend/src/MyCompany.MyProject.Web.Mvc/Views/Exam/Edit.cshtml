@using MyCompany.MyProject.Exams.Dto
@model ExamDetailDto
@{
    ViewBag.Title = "Chỉnh sửa Đề thi: " + Model.Title;
}

<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-7">
                <h1 class="m-0 text-dark">
                    <i class="fas fa-edit text-warning mr-2"></i>Chỉnh sửa Đề thi: <span class="text-primary">@Model.Title</span>
                </h1>
                <p class="text-muted mb-0">Cập nhật nội dung câu hỏi, các lựa chọn A, B, C, D hoặc đáp án đúng.</p>
            </div>
            <div class="col-sm-5 text-right">
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-info shadow-sm">
                    <i class="fas fa-eye mr-1"></i> Xem trước đề
                </a>
                <a asp-action="Index" class="btn btn-secondary shadow-sm ml-1">
                    <i class="fas fa-arrow-left mr-1"></i> Danh sách
                </a>
            </div>
        </div>
    </div>
</section>

<section class="content">
    <div class="container-fluid">
        <div id="alertPlaceholder"></div>

        @foreach (var group in Model.QuestionGroups.OrderBy(g => g.PartNumber).ThenBy(g => g.OrderIndex))
        {
            <div class="card card-outline card-secondary shadow-sm mb-4">
                <div class="card-header bg-light">
                    <h5 class="card-title font-weight-bold mb-0">
                        <span class="badge badge-info mr-2">Part @group.PartNumber</span>
                        @group.PassageTitle
                    </h5>
                </div>
                <div class="card-body">
                    @if (!string.IsNullOrWhiteSpace(group.PassageContent) && group.PartNumber != 5)
                    {
                        <div class="form-group">
                            <label class="font-weight-bold">Đoạn văn đọc hiểu:</label>
                            <textarea class="form-control" rows="5" readonly style="background-color: #f8f9fa;">@group.PassageContent</textarea>
                        </div>
                    }

                    <div class="row">
                        @foreach (var q in group.Questions.OrderBy(x => x.QuestionNumber))
                        {
                            <div class="col-md-6 mb-3">
                                <div class="card card-outline card-light border shadow-xs h-100" id="card-q-@q.Id">
                                    <div class="card-header py-2 bg-light">
                                        <span class="badge badge-primary font-weight-bold">Câu @q.QuestionNumber</span>
                                        <button type="button" class="btn btn-sm btn-success float-right save-q-btn" data-qid="@q.Id">
                                            <i class="fas fa-save mr-1"></i> Lưu câu này
                                        </button>
                                    </div>
                                    <div class="card-body p-3">
                                        <div class="form-group mb-2">
                                            <label class="small font-weight-bold text-muted">Nội dung câu hỏi:</label>
                                            <textarea class="form-control form-control-sm" id="text-@q.Id" rows="2">@q.QuestionText</textarea>
                                        </div>

                                        <div class="form-row">
                                            <div class="col-6 mb-2">
                                                <div class="input-group input-group-sm">
                                                    <div class="input-group-prepend"><span class="input-group-text font-weight-bold">A</span></div>
                                                    <input type="text" class="form-control" id="optA-@q.Id" value="@q.OptionA" />
                                                </div>
                                            </div>
                                            <div class="col-6 mb-2">
                                                <div class="input-group input-group-sm">
                                                    <div class="input-group-prepend"><span class="input-group-text font-weight-bold">B</span></div>
                                                    <input type="text" class="form-control" id="optB-@q.Id" value="@q.OptionB" />
                                                </div>
                                            </div>
                                            <div class="col-6 mb-2">
                                                <div class="input-group input-group-sm">
                                                    <div class="input-group-prepend"><span class="input-group-text font-weight-bold">C</span></div>
                                                    <input type="text" class="form-control" id="optC-@q.Id" value="@q.OptionC" />
                                                </div>
                                            </div>
                                            <div class="col-6 mb-2">
                                                <div class="input-group input-group-sm">
                                                    <div class="input-group-prepend"><span class="input-group-text font-weight-bold">D</span></div>
                                                    <input type="text" class="form-control" id="optD-@q.Id" value="@q.OptionD" />
                                                </div>
                                            </div>
                                        </div>

                                        <div class="form-group mb-0 mt-1">
                                            <label class="small font-weight-bold text-success">Đáp án đúng:</label>
                                            <select class="form-control form-control-sm font-weight-bold" id="ans-@q.Id" style="border-color: #28a745;">
                                                <option value="A" selected="@(q.CorrectOption == "A")">Đáp án (A)</option>
                                                <option value="B" selected="@(q.CorrectOption == "B")">Đáp án (B)</option>
                                                <option value="C" selected="@(q.CorrectOption == "C")">Đáp án (C)</option>
                                                <option value="D" selected="@(q.CorrectOption == "D")">Đáp án (D)</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</section>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('.save-q-btn').click(function () {
                var qid = $(this).data('qid');
                var payload = {
                    QuestionId: qid,
                    QuestionText: $('#text-' + qid).val(),
                    OptionA: $('#optA-' + qid).val(),
                    OptionB: $('#optB-' + qid).val(),
                    OptionC: $('#optC-' + qid).val(),
                    OptionD: $('#optD-' + qid).val(),
                    CorrectOption: $('#ans-' + qid).val()
                };

                var btn = $(this);
                btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin mr-1"></i> Đang lưu...');

                $.ajax({
                    url: '@Url.Action("UpdateQuestion", "Exam")',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(payload),
                    success: function (res) {
                        btn.prop('disabled', false).html('<i class="fas fa-check mr-1"></i> Đã lưu');
                        $('#card-q-' + qid).addClass('border-success');
                        setTimeout(function () {
                            btn.html('<i class="fas fa-save mr-1"></i> Lưu câu này');
                            $('#card-q-' + qid).removeClass('border-success');
                        }, 2000);
                    },
                    error: function (xhr) {
                        btn.prop('disabled', false).html('<i class="fas fa-save mr-1"></i> Lưu câu này');
                        alert('Lỗi cập nhật: ' + (xhr.responseJSON?.message || 'Không thể kết nối máy chủ.'));
                    }
                });
            });
        });
    </script>
}
